{
  "name": "mado-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "build": "esbuild src/main.ts --bundle --minify --format=iife --outfile=dist/app.js && npm run copy-assets",
    "dev": "npm run copy-assets && esbuild src/main.ts --bundle --format=iife --outfile=dist/app.js --watch",
    "test": "node tests/fontCommit.test.ts && node tests/gutter.test.ts && node tests/tocGutter.test.ts && node tests/renderScheduler.test.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.1",
    "@lezer/highlight": "^1.2.1",
    "katex": "^0.16.47"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
